{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gallery-analytics",
	"main": "src/index.js",
	"compatibility_date": "2026-11-21",
	"workers_dev": true,
	"vars": {
		"CF_ACCOUNT_TAG": "489f517d0d171c13b247d5abb8d56237",
		"CF_SITE_TAG": "afff4d33c374478089fe19a5f146a69e",
		"GALLERY_HOST": "jeffreyracine.github.io",
		"GALLERY_PATH_PREFIX": "/gallery/",
		"GALLERY_ORIGIN": "https://jeffreyracine.github.io",
		"LOCAL_ORIGINS": "http://127.0.0.1:8765,http://localhost:8765",
		"MIN_PUBLIC_COUNT": "5",
		"TOP_LIMIT": "10",
		"STALE_AFTER_HOURS": "12"
	},
	"kv_namespaces": [
		{
			"binding": "GALLERY_ANALYTICS_CACHE",
			"id": "0b703a590fdf4749a5bcc30f121ca9dc"
		}
	],
	"triggers": {
		"crons": [
			"17 */6 * * *"
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.01
	}
}
